#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for the SH-ESP32 test-jig DUT flashing bundle.
#

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

readonly DRIVE_ROOT="/Users/mairas/Library/CloudStorage/GoogleDrive-matti.airas@hatlabs.fi/Shared drives/Hat Labs/Manufacturing"
readonly DRIVE_DEST="$DRIVE_ROOT/SH-ESP32/test-jig/device-under-test"

################################################################################
# Deployment Commands

function sync-drive {
  #@ Mirror the flashing bundle to the Manufacturing shared drive
  #@ Category: Deploy
  if [[ ! -d "$DRIVE_ROOT" ]]; then
    echo "Error: Manufacturing shared drive not mounted at:" >&2
    echo "  $DRIVE_ROOT" >&2
    exit 1
  fi

  echo "Syncing flashing bundle to:"
  echo "  $DRIVE_DEST"
  mkdir -p "$DRIVE_DEST/firmware"
  rsync -a --delete firmware/ "$DRIVE_DEST/firmware/"
  rsync -a autoflash.sh flash.command README.md "$DRIVE_DEST/"
  echo "Sync complete."
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "SH-ESP32 test-jig DUT - Flashing Bundle Commands"
  echo "================================================"
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
